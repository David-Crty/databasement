---
const home = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="robots" content="noindex" />
        <meta http-equiv="refresh" content={`0; url=${home}`} />
        <link rel="canonical" href={home} />
        <title>Search</title>
    </head>
    <body>
        <p>Search moved into every page. <a href={home}>Go to the documentation</a>.</p>
    </body>
</html>
