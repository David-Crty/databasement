---
import Default from '@astrojs/starlight/components/Banner.astro';
import announcement from '../../announcement.mjs';

const html = announcement?.html.replace(/href="(?![a-z]+:|\/|#)/g, `href="${import.meta.env.BASE_URL}`);
---

{
    announcement && (
        <div class="announcement" data-tone={announcement.tone} data-id={announcement.id} data-pagefind-ignore hidden>
            <p set:html={html} />
            <button type="button" aria-label="Close">×</button>
        </div>
    )
}
<Default />

<script>
    for (const banner of document.querySelectorAll<HTMLElement>('.announcement')) {
        const key = `announcement-closed:${banner.dataset.id}`;
        let closed = false;
        try {
            closed = localStorage.getItem(key) === '1';
        } catch {}
        banner.hidden = closed;
        banner.querySelector('button')?.addEventListener('click', () => {
            banner.hidden = true;
            try {
                localStorage.setItem(key, '1');
            } catch {}
        });
    }
</script>

<style>
    .announcement {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.5rem var(--sl-nav-pad-x);
        background: var(--dbm-announcement-bg);
        color: var(--dbm-announcement-text);
        font-size: var(--sl-text-sm);
    }
    .announcement[hidden] {
        display: none;
    }
    .announcement p {
        flex: 1;
        margin: 0;
        text-align: center;
        text-wrap: balance;
    }
    .announcement :global(a) {
        color: inherit;
        font-weight: 600;
    }
    .announcement button {
        background: none;
        border: 0;
        color: inherit;
        font-size: 1.25rem;
        line-height: 1;
        cursor: pointer;
    }
</style>
